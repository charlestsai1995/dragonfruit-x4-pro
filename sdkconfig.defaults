# Target: Xteink X4 Pro (ESP32-S3, 16MB QIO Flash, 8MB Octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# CPU clock at maximum 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Enable 8 MB Octal PSRAM at 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Flash configuration (16MB, QIO, 80MHz)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Native USB Serial/JTAG console (Xteink X4 Pro USB-C port)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FATFS long filenames (needed to match palm.rom on the SD card)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Disable task watchdog during long emulation loops
CONFIG_ESP_TASK_WDT_EN=n

# FreeRTOS tick at 1000 Hz for responsive input polling
CONFIG_FREERTOS_HZ=1000

# Optimize for performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Allow MALLOC_CAP_EXEC in SRAM1 for the 68k->Xtensa burst JIT
CONFIG_ESP_SYSTEM_MEMPROT=n
